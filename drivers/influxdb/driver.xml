<devicedata>
  <name>InfluxDB Data Logger</name>
  <version/>
  <manufacturer>Finite Labs</manufacturer>
  <model>InfluxDB Data Logger</model>
  <creator>Derek Miller</creator>
  <small image_source="c4z">icons/device_sm.png</small>
  <large image_source="c4z">icons/device_lg.png</large>
  <control>lua_gen</control>
  <controlmethod>ip</controlmethod>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 Finite Labs, LLC. All rights reserved.</copyright>
  <created>03/24/2026 12:00:00 PM</created>
  <modified/>
  <combo>true</combo>
  <minimum_os_version>3.3.0</minimum_os_version>
  <composer_categories>
    <category>Utility</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>INFLUXDB_CONNECTED</name>
      <type>BOOL</type>
      <condition_statement>InfluxDB connection status</condition_statement>
      <description>NAME is STRING</description>
      <true_text>Connected</true_text>
      <false_text>Disconnected</false_text>
    </conditional>
  </conditionals>
  <events>
    <event>
      <id>1</id>
      <name>Connected</name>
      <description>When NAME connects to InfluxDB</description>
    </event>
    <event>
      <id>2</id>
      <name>Disconnected</name>
      <description>When NAME disconnects from InfluxDB</description>
    </event>
    <event>
      <id>3</id>
      <name>Write Error</name>
      <description>When NAME encounters a write error</description>
    </event>
    <event>
      <id>4</id>
      <name>Buffer Full</name>
      <description>When NAME write buffer is full</description>
    </event>
    <event>
      <id>5</id>
      <name>Extended Outage</name>
      <description>When NAME has been disconnected longer than the outage notification threshold</description>
    </event>
  </events>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <properties>
      <property>
        <name>Cloud</name>
        <type>LABEL</type>
        <default>Cloud Settings</default>
      </property>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Cloud Status</name>
        <default/>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <!-- #endif -->
      <property>
        <name>Automatic Updates</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>On</default>
      </property>
      <!-- #ifndef DRIVERCENTRAL -->
      <property>
        <name>Update Channel</name>
        <type>LIST</type>
        <default>Production</default>
        <items>
          <item>Production</item>
          <item>Prerelease</item>
        </items>
      </property>
      <!-- #endif -->
      <property>
        <name>Driver</name>
        <type>LABEL</type>
        <default>Driver Settings</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Log Level</name>
        <type>DYNAMIC_LIST</type>
        <default>3 - Info</default>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
      </property>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Support Code</name>
        <type>STRING</type>
        <default/>
        <description>Enter only a code from Finite Labs support. It opens the Lua window for an hour.</description>
        <password>true</password>
      </property>
      <property>
        <name>Cloud Monitoring</name>
        <type>LIST</type>
        <default>Enabled</default>
        <items>
          <item>Disabled</item>
          <item>Enabled</item>
        </items>
        <description>Sends memory and error reports to Finite Labs so we can fix driver problems.</description>
      </property>
      <!-- #endif -->
      <property>
        <name>InfluxDB Settings</name>
        <type>LABEL</type>
        <default>InfluxDB Connection</default>
      </property>
      <property>
        <name>InfluxDB URL</name>
        <type>STRING</type>
        <default/>
        <description>Your InfluxDB server's address, with its port.</description>
      </property>
      <property>
        <name>API Token</name>
        <type>STRING</type>
        <default/>
        <password>true</password>
        <description>InfluxDB API authentication token</description>
      </property>
      <property>
        <name>Database</name>
        <type>STRING</type>
        <default/>
        <description>The database (bucket) the driver writes to.</description>
      </property>
      <property>
        <name>Write Precision</name>
        <type>LIST</type>
        <default>ms</default>
        <items>
          <item>ns</item>
          <item>us</item>
          <item>ms</item>
          <item>s</item>
        </items>
        <description>How precisely each point's time is stored.</description>
      </property>
      <property>
        <name>Default Write Interval</name>
        <type>LIST</type>
        <default>1m</default>
        <items>
          <item>10s</item>
          <item>30s</item>
          <item>1m</item>
          <item>5m</item>
          <item>15m</item>
        </items>
        <description>How often readings are sent, unless a measurement sets its own.</description>
      </property>
      <property>
        <name>Offline Buffer Settings</name>
        <type>LABEL</type>
        <default>Offline Buffer &amp; Retry</default>
      </property>
      <property>
        <name>Outage Notification Threshold</name>
        <type>LIST</type>
        <default>5m</default>
        <items>
          <item>1m</item>
          <item>5m</item>
          <item>15m</item>
          <item>30m</item>
          <item>1h</item>
        </items>
        <description>How long writes can fail before Extended Outage fires.</description>
      </property>
    </properties>
    <tabs>
      <tab name="Settings" file="html/index.html"/>
    </tabs>
    <actions>
      <!-- #ifndef DRIVERCENTRAL -->
      <action>
        <name>Update Drivers</name>
        <command>Update_Drivers</command>
      </action>
      <!-- #endif -->
      <!-- #ifdef DRIVERCENTRAL -->
      <action>
        <name>Diagnostics Snapshot</name>
        <command>DiagnosticsSnapshot</command>
      </action>
      <!-- #endif -->
    </actions>
  </config>

</devicedata>
